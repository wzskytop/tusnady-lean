--@def innerCount
example {n : ℕ} (b h j : ℕ) (P : Fin n → ℝ × ℝ) (c v : ℕ) :
    innerCount b h j P c v = (Finset.univ.filter (fun i => P i ∈ innerRegion b h j c v)).card :=

--@pin ae_heights_injective

--@pin ae_noGrid

-- On that event the points lie in `(0,1]²` (indeed in `(0,1)²`).
--@def InUnit
example {n : ℕ} (P : Fin n → ℝ × ℝ) :
    InUnit P ↔ ∀ i, (P i).1 ∈ Set.Ioc (0 : ℝ) 1 ∧ (P i).2 ∈ Set.Ioc (0 : ℝ) 1 := Iff.rfl

